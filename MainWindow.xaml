<Window x:Class="ClinicaLongevidadApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClinicaLongevidadApp.Views"
        Title="Clínica Longevidad"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        WindowState="Maximized">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Administración">
                <MenuItem x:Name="MenuItemAuditAdmin" Header="Abrir Auditoría" Click="MenuItemAuditAdmin_Click" Visibility="Collapsed" />
                <MenuItem x:Name="MenuItemDebugAdmin" Header="Toggle Admin (dev)" Click="MenuItemDebugAdmin_Click" Visibility="Collapsed" />
            </MenuItem>
        </Menu>

        <!-- ⭐ Mostramos directamente el Dashboard -->
        <local:WelcomeView />
    </DockPanel>

</Window>
