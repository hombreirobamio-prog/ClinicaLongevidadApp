<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClinicaLongevidadApp.Tests\**\*.cs" />
    <EmbeddedResource Remove="ClinicaLongevidadApp.Tests\**\*" />
    <None Remove="ClinicaLongevidadApp.Tests\**\*" />
    <Page Remove="ClinicaLongevidadApp.Tests\**\*" />
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Page Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <!-- Tools source files must not be compiled into the main WPF application. The individual tool projects
       are built separately (see tools/*/*.csproj). Any accidental Compile Include for tool sources
       will cause duplicate entry-point errors when building the app or solution. -->

  <!-- tools/CheckAdmin is a separate tool project and should not be compiled into the main application. -->

  <!-- Test and tools sources are excluded from main build by default -->

  <!-- Test assembly initializer should not be compiled into the main application. -->

  <ItemGroup>
    <None Include=".github\workflows\ci.yml" />
    <None Include=".github\workflows\dotnet-build-test.yml" />
    <None Include="ClinicaLongevidadApp.Tests\ClinicaLongevidadApp.Tests.csproj" />
    <None Include="ClinicaLongevidadApp.Tests\README.md" />
    <None Include="tools\AuditDecrypt\AuditDecrypt.csproj" />
    <None Include="tools\CheckAdmin\CheckAdmin.csproj" />
    <None Include="tools\RotateKeys\README.md" />
    <None Include="tools\RotateKeys\RotateKeys.csproj" />
    <!-- tools project is excluded from main build to avoid multiple entry points -->
  </ItemGroup>

</Project>
