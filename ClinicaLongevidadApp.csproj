<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClinicaLongevidadApp.Tests\**\*.cs" />
    <EmbeddedResource Remove="ClinicaLongevidadApp.Tests\**\*" />
    <None Remove="ClinicaLongevidadApp.Tests\**\*" />
    <Page Remove="ClinicaLongevidadApp.Tests\**\*" />
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Page Remove="tools\**\*" />
  </ItemGroup>

  <!-- Explicit Compile include for tools\InvokeBackup\Program.cs removed.
       Tools live in their own projects under tools/* and are built separately.
       Including tool entry points in the main WPF project caused a build error
       when the tool source was not present. -->

  <!-- Tool programs should not be compiled into the main application. Individual tools live
       in the `tools/*` folder and are built as separate projects. The explicit Compile
       include of a tool's Program.cs caused duplicate entry-point errors and was removed. -->

  <!-- Tool entry points should not be compiled into the main application. Tools are separate projects
       and are built independently. The explicit Compile include for tool Program.cs files caused
       duplicate entry-point errors; they are intentionally omitted here. -->

  <!-- Tools are built as separate projects and must not be compiled into the main WPF app. -->
  <!-- Tools source files must not be compiled into the main WPF application. The individual tool projects
       are built separately (see tools/*/*.csproj). Any accidental Compile Include for tool sources
       will cause duplicate entry-point errors when building the app or solution. -->

  <!-- tools/CheckAdmin is a separate tool project and should not be compiled into the main application. -->

  <!-- Test and tools sources are excluded from main build by default -->

  <!-- Test assembly initializer should not be compiled into the main application. -->

  <ItemGroup>
    <None Include=".github\workflows\audit-integrity-alert.yml" />
    <None Include=".github\workflows\audit-integrity.yml" />
    <None Include=".github\workflows\audit-pipeline.yml" />
    <None Include=".github\workflows\ci.yml" />
    <None Include=".github\workflows\dotnet-build-test.yml" />
    <None Include="ClinicaLongevidadApp.Tests\ClinicaLongevidadApp.Tests.csproj" />
    <None Include="ClinicaLongevidadApp.Tests\README.md" />
    <None Include="tools\AuditDecrypt\AuditDecrypt.csproj" />
    <None Include="tools\AuditDecrypt\README.md" />
    <None Include="tools\BACKFILL_PLAN.md" />
    <None Include="tools\DbAuditInspect\DbAuditInspect.csproj" />
    <None Include="tools\GenerateIntegrity\GenerateIntegrity.csproj" />
    <None Include="tools\InvokeBackup\InvokeBackup.csproj" />
    <None Include="tools\remove_untracked.py" />
    <None Include="tools\RotateKeys\RotateKeys.csproj" />
    <None Include="tools\RunAuditDiagnostics\RunAuditDiagnostics.csproj" />
    <None Include="tools\run_cleanup.ps1" />
    <None Include="tools\summarize_integrity_report.ps1" />
    <None Include="tools\VerifyIntegrity\VerifyIntegrity.csproj" />
    <!-- tools project is excluded from main build to avoid multiple entry points -->
  </ItemGroup>

  <ItemGroup>
    <Folder Include="tools\NewFolder\" />
  </ItemGroup>

</Project>
