<UserControl x:Class="ClinicaLongevidadApp.Views.AreaSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush_FondoClinico}">

    <Grid>

        <!-- Título fuera del panel -->
        <TextBlock Text="Selecciona tu área"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush_TextoClaro}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0 160 0 0"/>

        <!-- Panel central con botones -->
        <Border Background="{StaticResource Brush_FondoClinico}"
                CornerRadius="20"
                Padding="40"
                Width="860"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <UniformGrid Rows="1"
                         Columns="3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0 20 0 0">

                <Button Content="Administración"
                        Command="{Binding AdministracionCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Width="200"
                        Height="80"
                        Margin="0 0 40 0"/>

                <Button Content="Recepción"
                        Command="{Binding RecepcionCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Width="200"
                        Height="80"
                        Margin="0 0 40 0"/>

                <Button Content="Médico"
                        Command="{Binding MedicoCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Width="200"
                        Height="80"/>
            </UniformGrid>

        </Border>

    </Grid>
</UserControl>
