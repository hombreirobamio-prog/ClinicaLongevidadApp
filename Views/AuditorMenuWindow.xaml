<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClinicaLongevidadApp.Views;assembly=ClinicaLongevidadApp"
        x:Class="ClinicaLongevidadApp.Views.AuditorMenuWindow"
        Title="Menú Auditor" Height="560" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Brush_FondoOscuro}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Menú Auditor" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource Brush_TextoClaro}" Margin="0,0,0,8"/>

        <!-- Área de resultados / impreso -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Increase left column so ZIP names fit better -->
                <ColumnDefinition Width="300"/>
                <!-- Give more space to central area where buttons and manifest live -->
                <ColumnDefinition Width="5*"/>
                <!-- Keep delivery panel narrower but allow resizing with GridSplitter -->
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left ZIPs container -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,28,8,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="ZIPs detectados" Foreground="{StaticResource Brush_TextoClaro}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="LstDetectedZips" Height="220" Margin="0,0,0,8" MouseDoubleClick="LstDetectedZips_MouseDoubleClick"
                         Background="{StaticResource Brush_PanelOscuro}" Foreground="{StaticResource Brush_TextoClaro}"
                         HorizontalAlignment="Stretch" BorderThickness="1" BorderBrush="{StaticResource Brush_PrincipalAzul}" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="BtnOpenContainingFolder" Content="Abrir carpeta contenedora" Width="160" Height="28" Click="BtnOpenContainingFolder_Click" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Central panel with action buttons, manifest UI and log -->
            <!-- Shifted right to align with the top action buttons -->
            <DockPanel Grid.Column="1" Margin="12,0,8,0">
                <!-- Top action buttons in a single horizontal row; use UniformGrid so all items share equal width -->
                <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="15,0,0,12">
                    <Button x:Name="BtnSelectZip" Height="36" Click="BtnSelectZip_Click" Margin="6,0">Seleccionar ZIP y calcular SHA256</Button>
                    <Button x:Name="BtnDetectZips" Height="36" Click="BtnDetectZips_Click" Margin="6,0">Detectar ZIPs (carpeta estándar)</Button>
                    <Button x:Name="BtnVerifyManifest" Height="36" Click="BtnVerifyManifest_Click" Margin="6,0">Verificar manifiesto</Button>
                    <Button x:Name="BtnUnpack" Height="36" Click="BtnUnpack_Click" Margin="6,0">Descomprimir</Button>
                    <Button x:Name="BtnGenDiag" Height="36" Click="BtnGenDiag_Click" Margin="6,0">Generar diagnósticos</Button>
                    <!-- manifest actions moved into top row -->
                    <Button x:Name="BtnLoadManifest" Height="36" Click="BtnLoadManifest_Click" Margin="6,0">Cargar manifiesto</Button>
                    <Button x:Name="BtnVerifyLoadedManifest" Height="36" Click="BtnVerifyLoadedManifest_Click" Margin="6,0">Verificar manifiesto (local)</Button>
                    <!-- HMAC validation: enter key (base64 or hex) and validate -->
                    <PasswordBox x:Name="PwdHmacKey" Height="36" Margin="6,0" ToolTip="Clave HMAC (Base64 o hex)"
                                 Background="{StaticResource Brush_PanelOscuro}"
                                 Foreground="{StaticResource Brush_TextoClaro}"
                                 BorderBrush="{StaticResource Brush_PrincipalAzul}"
                                 BorderThickness="1"
                                 Padding="6"
                                 VerticalContentAlignment="Center" />
                    <Button x:Name="BtnValidateHmac" Height="36" Click="BtnValidateHmac_Click" Margin="6,0">Validar HMAC</Button>
                </UniformGrid>

                <!-- manifest buttons removed (now in top actions row) -->

                <!-- Make manifest grid and SHA256 log occupy equal heights and align -->
                <Grid DockPanel.Dock="Top" Margin="15,0,0,12">
                    <Grid.RowDefinitions>
                        <!-- Make manifest (DataGrid) shorter vertically than the log -->
                        <RowDefinition Height="0.5*" />
                        <RowDefinition Height="1.5*" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DgManifest" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,6"
                              Background="{StaticResource Brush_PanelOscuro}"
                              Foreground="{StaticResource Brush_TextoClaro}"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="{StaticResource Brush_PrincipalAzul}"
                              ColumnHeaderHeight="36">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Black" />
                                <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="FontSize" Value="13" />
                                <!-- Add right border to show vertical separator in header -->
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush_PrincipalAzul}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ruta" Binding="{Binding FilePath}" Width="*" />
                            <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256}" Width="2*" />
                            <DataGridTextColumn Header="HMAC" Binding="{Binding Hmac}" Width="2*" />
                            <DataGridTextColumn Header="HMAC Resultado" Binding="{Binding HmacResult}" Width="140" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

            <!-- GridSplitter to allow user resizing between central area and delivery panel -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="{StaticResource Brush_PrincipalAzul}" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

                    <TextBox x:Name="TxtLog" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" IsReadOnly="True" Background="{StaticResource Brush_PanelOscuro}"
                             Foreground="{StaticResource Brush_TextoClaro}" Padding="8"
                             VerticalContentAlignment="Top" VerticalAlignment="Stretch" />
                </Grid>
            </DockPanel>

            <!-- Delivery panel -->
            <StackPanel Grid.Column="2" Grid.Row="0" Margin="8,36,0,0" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="Entrega" FontWeight="SemiBold" Foreground="{StaticResource Brush_TextoClaro}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="Auditor:" Foreground="{StaticResource Brush_TextoClaro}" Margin="6,4,6,2" />
                <Grid Margin="0,0,6,8">
                    <TextBox x:Name="TxtAuditorName" Width="188" Height="24" Background="{StaticResource Brush_PanelOscuro}" Foreground="{StaticResource Brush_TextoClaro}"
                             BorderBrush="{StaticResource Brush_PrincipalAzul}" BorderThickness="1" Padding="4" HorizontalAlignment="Left" />
                    <TextBlock Text="Nombre" IsHitTestVisible="False" Foreground="#FF8A8A8A" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtAuditorName}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <RadioButton x:Name="RbGitHub" Content="GitHub Release" IsChecked="True" Margin="8,0,8,6" Foreground="{StaticResource Brush_TextoClaro}" />
                <RadioButton x:Name="RbS3" Content="S3 (aws cli / presigned URL)" Margin="8,0,8,6" Foreground="{StaticResource Brush_TextoClaro}" />
                <RadioButton x:Name="RbAzure" Content="Azure Blob (az cli / SAS)" Margin="8,0,8,6" Foreground="{StaticResource Brush_TextoClaro}" />
                <RadioButton x:Name="RbSftp" Content="SFTP / SCP" Margin="8,0,8,6" Foreground="{StaticResource Brush_TextoClaro}" />
                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Left">
                    <Button x:Name="BtnPrepareDeliver" Content="Preparar impreso" Width="160" Height="30" Click="BtnPrepareDeliver_Click" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnSave" Content="Guardar impreso" Width="160" Margin="4,8,0,0" Height="30" Click="BtnSave_Click" HorizontalAlignment="Left"/>
                    <!-- HMAC key persistence controls -->
                    <Button x:Name="BtnSaveHmacKey" Content="Guardar clave segura" Width="160" Margin="0,8,4,0" Height="26" Click="BtnSaveHmacKey_Click" HorizontalAlignment="Right"/>
                    <Button x:Name="BtnDeleteHmacKey" Content="Eliminar clave guardada" Width="160" Margin="0,8,4,0" Height="26" Click="BtnDeleteHmacKey_Click" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>

            <!-- Close and Clear buttons under central column -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnClearScreen" Width="140" Height="32" Click="BtnClearScreen_Click" Margin="0,0,8,0">Limpiar pantalla</Button>
                <Button Width="100" Height="32" Click="BtnClose_Click">Cerrar</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
