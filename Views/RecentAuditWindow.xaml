<Window x:Class="ClinicaLongevidadApp.Views.RecentAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Últimos movimientos de auditoría" Height="450" Width="800">
    <DockPanel Margin="8">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right">
            <Button Content="Refresh" Margin="4" Click="Refresh_Click" />
            <Button Content="Cerrar" Margin="4" Click="Close_Click" />
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding FechaHora}" Width="170" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioAdmin}" Width="120" />
                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="*" />
                <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" Width="100" />
                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
