<UserControl x:Class="ClinicaLongevidadApp.Views.FestivosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush_FondoOscuro}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{StaticResource Brush_FondoPanel}" />
            <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush_PrincipalAzul}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="{x:Type DatePickerTextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource Brush_FondoPanel}" />
            <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Border Background="{StaticResource Brush_PanelOscuro}"
                BorderBrush="{StaticResource Brush_PrincipalVerde}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="25"
                Effect="{StaticResource SombraSuave}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Festivos"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush_TextoClaro}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Grid.Row="1"
                        Background="{StaticResource Brush_FondoPanel}"
                        BorderBrush="{StaticResource Brush_PrincipalVerde}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker Grid.Column="0"
                                    SelectedDate="{Binding FechaFestivo, Mode=TwoWay}"/>

                        <TextBox Grid.Column="1"
                                 Margin="10,0,10,0"
                                 Text="{Binding NombreFestivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nombre del festivo"/>

                        <ComboBox Grid.Column="2"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding TiposFestivo}"
                                  SelectedItem="{Binding TipoFestivo, Mode=TwoWay}"/>

                        <Button Grid.Column="3"
                                Content="Guardar"
                                Command="{Binding GuardarFestivoCommand}"
                                Style="{StaticResource EstiloBotonPrincipal}"
                                Width="120"
                                Height="45"/>

                        <Button Grid.Column="4"
                                Content="Eliminar"
                                Command="{Binding EliminarFestivoCommand}"
                                Style="{StaticResource EstiloBotonSecundario}"
                                Width="120"
                                Height="45"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Festivos}"
                          SelectedItem="{Binding FestivoSeleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          Background="{StaticResource Brush_FondoPanel}"
                          Foreground="{StaticResource Brush_TextoClaro}"
                          RowBackground="{StaticResource Brush_FondoPanel}"
                          AlternatingRowBackground="{StaticResource Brush_PanelOscuro}"
                          BorderBrush="{StaticResource Brush_PrincipalVerde}"
                          BorderThickness="1"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#333333"
                          VerticalGridLinesBrush="#333333"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}"
                                            Width="140" />
                        <DataGridTextColumn Header="Festivo"
                                            Binding="{Binding Nombre}"
                                            Width="*" />
                        <DataGridTemplateColumn Header="Tipo"
                                                Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Rectangle Width="12"
                                                   Height="12"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Margin="0,0,8,0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="#98E69B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Autonomico">
                                                            <Setter Property="Fill" Value="#C9A0FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Auton&#243;mico">
                                                            <Setter Property="Fill" Value="#C9A0FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tipo}" Value="Local">
                                                            <Setter Property="Fill" Value="#FFB36B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <TextBlock Text="{Binding Tipo}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextoClaro}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource Brush_PanelOscuro}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush_PrincipalVerde}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource Brush_FondoPanel}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextoClaro}" />
                            <Setter Property="BorderBrush" Value="#333333" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
