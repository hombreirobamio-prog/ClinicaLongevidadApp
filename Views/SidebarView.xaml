<UserControl x:Class="ClinicaLongevidadApp.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush_PanelOscuro}">

    <StackPanel Margin="12"
                HorizontalAlignment="Stretch">

        <TextBlock Text="Panel"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brush_TextoClaro}"
                   Margin="0 0 0 20"/>

        <Button Content="Inicio"
                Command="{Binding IrHomeCommand}"
                Style="{StaticResource EstiloBotonPrincipal}"
                 Width="Auto"
                 MinHeight="45"
                 HorizontalAlignment="Stretch"
                Margin="0 10 0 0"/>

        <Button Content="Usuarios"
                Command="{Binding IrUsuariosCommand}"
                Style="{StaticResource EstiloBotonPrincipal}"
                 Width="Auto"
                 MinHeight="45"
                 HorizontalAlignment="Stretch"
                Margin="0 10 0 0"
                IsEnabled="{Binding PuedeVerUsuarios}"/>

        <Button Content="Auditoría"
                Command="{Binding MostrarAuditoriaCommand}"
                Style="{StaticResource EstiloBotonPrincipal}"
                 Width="Auto"
                 MinHeight="45"
                 HorizontalAlignment="Stretch"
                Margin="0 10 0 0"
                IsEnabled="{Binding PuedeVerAuditoria}"/>

        <Button Content="Festivos"
                Command="{Binding MostrarFestivosCommand}"
                Style="{StaticResource EstiloBotonPrincipal}"
                 Width="Auto"
                 MinHeight="45"
                 HorizontalAlignment="Stretch"
                Margin="0 10 0 0"
                IsEnabled="{Binding PuedeVerAuditoria}"/>

        <Button Content="Cerrar sesión"
                Command="{Binding CerrarSesionCommand}"
                Style="{StaticResource EstiloBotonSecundario}"
                 Width="Auto"
                 MinHeight="45"
                 HorizontalAlignment="Stretch"
                Margin="0 30 0 0"/>

    </StackPanel>
</UserControl>
