<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Match the main app target so a ProjectReference to the WPF app is allowed. This is
         a minimal change to unblock the operator tool. Consider separating shared
         services into a class library targeting net8.0 in the future. -->
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ClinicaLongevidadApp.csproj" />
  </ItemGroup>
</Project>
